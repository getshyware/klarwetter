<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Ortskachel im Widget. Achtung: In Widgets sind nur bestimmte Bausteine erlaubt (kein <View>). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_margin="3dp"
    android:layout_weight="1"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="2dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <!-- Kopfzeile: Blättern links (nur bei mehreren Orten), Menü rechts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/w_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="invisible">

            <TextView
                android:id="@+id/nav_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Vorheriger Ort"
                android:includeFontPadding="false"
                android:paddingStart="4dp"
                android:paddingTop="2dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="‹"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/nav_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/nav_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Nächster Ort"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="›"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Orte bearbeiten"
            android:includeFontPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:text="•••"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Symbol links, Datum/Uhrzeit/Ort rechts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/w_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_cond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/w_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, d. MMM"
                android:format24Hour="EEE, d. MMM"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextClock
                android:id="@+id/w_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Mitte: Temperatur (wird kleiner statt abgeschnitten) und 3 Tage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_temp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/w_fc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_d1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/w_i1"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/w_t1"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_d2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/w_i2"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/w_t2"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_d3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/w_i3"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/w_t3"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Unten: Tag/Nacht und gefühlte Temperatur -->
    <TextView
        android:id="@+id/w_hl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_feel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
